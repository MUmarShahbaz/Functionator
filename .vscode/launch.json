{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run TypeScript",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "build-ts",
      "program": "${workspaceFolder}/temp/${fileBasenameNoExtension}.js",
      "outFiles": [
        "${workspaceFolder}/output/**/*.js"
      ],
      "console": "integratedTerminal"
    }
  ]
}